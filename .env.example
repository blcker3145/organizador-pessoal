# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API). Os dois valores são públicos por natureza: quem protege
# os dados são as regras de acesso do banco. Nunca coloque a chave da OpenAI aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-public-aqui

# Endereço (slug) da função de IA, se não for "ai". Ex.: smart-task
# VITE_SUPABASE_AI_FUNCTION=ai

# Endereço (slug) da função do Google Agenda, se não for "google-calendar"
# VITE_SUPABASE_GCAL_FUNCTION=google-calendar
